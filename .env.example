# Database (local Postgres via Homebrew)
DATABASE_URL=postgresql+asyncpg://user@localhost:5432/sequence_service

# Redis
REDIS_URL=redis://localhost:6379

# Gmail
GMAIL_ENABLED=true
GMAIL_SERVICE_ACCOUNT_FILE=/path/to/credentials/service-account.json
GMAIL_DELEGATED_USER=quinn@telnyx.com

# API
API_HOST=0.0.0.0
API_PORT=8001

# Workers
WORKER_CONCURRENCY=4

# Logging
LOG_LEVEL=INFO

# Telnyx Email API (REVOPS-1552). Per-mailbox transport selection: set
# Mailbox.transport='email_api' to route a mailbox through the Email API
# instead of Gmail. The key MUST be the whitelisted salesops account key;
# non-whitelisted keys fail with error code 10038. Never commit the value.
EMAIL_API_KEY=
EMAIL_API_BASE_URL=https://api.telnyx.com/v2
EMAIL_API_TIMEOUT=30.0

# Telnyx Email API webhook receiver (REVOPS-1552). The Ed25519 public key
# provisioned in the Telnyx portal for verifying inbound delivery-event
# webhook signatures. Base64-encoded raw 32-byte Ed25519 public key. Only
# the NAME is read from env — the key VALUE never appears in the repo.
# Empty string => the endpoint rejects all events with 401 (fail closed).
TELNYX_WEBHOOK_PUBLIC_KEY=
